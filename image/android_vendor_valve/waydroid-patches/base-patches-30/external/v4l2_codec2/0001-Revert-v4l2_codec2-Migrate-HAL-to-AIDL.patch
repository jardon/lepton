-                      serviceName.c_str());
-            }
+            ALOGI("Codec2's IComponentStore service created.");
         }
     }
 
-    ABinderProcess_joinThreadPool();
+    android::hardware::joinRpcThreadpool();
     ALOGD("Service shutdown.");
     return 0;
 }
